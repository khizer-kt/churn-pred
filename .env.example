# Copy to .env and fill in. .env is gitignored; this file is committed.
# Free key (no card) from https://console.groq.com -> API Keys
GROQ_API_KEY=

# Chat model. NOTE: llama-3.3-70b-versatile is NOT available on current free
# accounts -- the client verifies availability at startup and falls back through
# PREFERRED_MODELS in src/llm/client.py if this one is not offered.
GROQ_MODEL=openai/gpt-oss-120b
